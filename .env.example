ENV=prod
BOT_TOKEN=
WEBHOOK_SECRET=            # випадковий рядок 32+ символи
PUBLIC_BASE_URL=https://tarilka.romis.cloud
ADMIN_TG_IDS=              # числові ID через кому; або python -m app.cli add-member --username … --admin
DATABASE_URL=postgresql+asyncpg://tarilka:***@postgres:5432/tarilka
MEDIA_DIR=/data/media
TIMEZONE=Europe/Kyiv

# Етап 2+
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
STT_MODEL=gpt-4o-mini-transcribe
WORKER_CONCURRENCY=2
YTDLP_COOKIES_FILE=/secrets/cookies.txt   # опційно
MEALIE_ENABLED=false
MEALIE_URL=http://mealie:9000
MEALIE_API_TOKEN=
